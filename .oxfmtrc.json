{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "tabWidth": 4,
    "trailingComma": "none",
    "arrowParens": "avoid",
    "printWidth": 120,
    "sortPackageJson": false,
    "ignorePatterns": [
        ".svelte-kit",
        "build",
        "dist",
        "node_modules",
        "*.log",
        "package-lock.json",
        "pnpm-lock.yaml",
        "bun.lockb"
    ]
}
